{
  "name": "pip-reader",
  "version": "1.3.0",
  "description": "Simple PiP reader window",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.27.0",
    "@xmldom/xmldom": "^0.8.0",
    "iconv-lite": "^0.6.3",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.pip.reader",
    "productName": "PipReader",
    "executableName": "PipReader",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-out"
    },
    "files": [
      "main.js",
      "preload.js",
      "txt-reader.js",
      "index.html",
      "welcome.html",
      "webview-preload.js",
      "win-window.ps1",
      "bs.json",
      "novel-sources.json",
      "使用说明.txt",
      "examples/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": ["win-window.ps1"],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PipReader.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": "PipReader"
    },
    "compression": "maximum",
    "asar": true
  }
}
